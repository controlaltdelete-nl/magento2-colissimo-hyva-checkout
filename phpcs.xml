<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="ColissimoHyva" xsi:noNamespaceSchemaLocation="phpcs.xsd">
    <description>Coding standard for the Colissimo Relay Point Picker for Hyvä Checkout.</description>

    <file>src</file>

    <arg name="extensions" value="php,phtml"/>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <rule ref="Magento2">
        <exclude name="Magento2.Annotation.MethodAnnotationStructure.NoCommentBlock"/>
        <exclude name="Magento2.Annotation.MethodArguments.NoCommentBlock"/>
    </rule>

    <rule ref="Generic.PHP.RequireStrictTypes">
        <severity>9</severity>
        <exclude-pattern>*.phtml</exclude-pattern>
    </rule>
</ruleset>
