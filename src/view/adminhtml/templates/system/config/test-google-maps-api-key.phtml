<?php
declare(strict_types=1);

use ControlAltDelete\ColissimoHyva\Block\Adminhtml\System\Config\TestGoogleMapsApiKeyButton;
use Magento\Framework\Escaper;
use Magento\Framework\View\Helper\SecureHtmlRenderer;

/** @var TestGoogleMapsApiKeyButton $block */
/** @var Escaper $escaper */
/** @var SecureHtmlRenderer $secureRenderer */
?>
<button type="button" class="action-default" id="colissimo-hyva-test-google-maps-api-key">
    <span><?= $escaper->escapeHtml((string)__('Test API key')) ?></span>
</button>
<ul id="colissimo-hyva-test-google-maps-api-key-results" class="note" style="list-style: none; margin: 1rem 0 0; padding: 0;"></ul>

<?php
$script = <<<SCRIPT
require(['jquery'], function ($) {
    const results = document.getElementById('colissimo-hyva-test-google-maps-api-key-results');

    const showResult = (label, isSuccess, message) => {
        const item = document.createElement('li');
        item.style.color = isSuccess ? '#185b00' : '#e22626';
        item.textContent = label + ': ' + message;
        results.appendChild(item);
    };

    const testServer = (apiKey) => $.ajax({
        url: '{$escaper->escapeJs($block->getTestUrl())}',
        type: 'POST',
        dataType: 'json',
        showLoader: true,
        data: {form_key: window.FORM_KEY, api_key: apiKey}
    }).then(
        response => showResult('{$escaper->escapeJs((string)__('Server (Geocoding API)'))}', response.success, response.message),
        () => showResult('{$escaper->escapeJs((string)__('Server (Geocoding API)'))}', false, '{$escaper->escapeJs((string)__('The test request failed.'))}')
    );

    const testBrowser = (apiKey) => fetch('https://places.googleapis.com/v1/places:searchText', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-Goog-Api-Key': apiKey, 'X-Goog-FieldMask': 'places.id'},
        body: JSON.stringify({textQuery: 'Paris'})
    }).then(response => response.json().then(body => showResult(
        '{$escaper->escapeJs((string)__('Browser (Places API (New))'))}',
        response.ok,
        response.ok ? '{$escaper->escapeJs((string)__('OK'))}' : (body.error && body.error.message) || response.status
    ))).catch(error => showResult('{$escaper->escapeJs((string)__('Browser (Places API (New))'))}', false, error.message));

    $('#colissimo-hyva-test-google-maps-api-key').on('click', function () {
        const apiKey = document.getElementById('{$escaper->escapeJs($block->getApiKeyInputId())}').value.trim();
        results.textContent = '';

        if (apiKey === '') {
            showResult('{$escaper->escapeJs((string)__('Test API key'))}', false, '{$escaper->escapeJs((string)__('Enter an API key first.'))}');
            return;
        }

        testServer(apiKey);
        testBrowser(apiKey);
    });
});
SCRIPT;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $script, false) ?>
